# devenv.container — Podman Quadlet TEMPLATE for VPS use.
#
# This is a TEMPLATE. `bin/devenv` substitutes the ${NAME}, ${PORT}, and
# ${ENV_FILE} placeholders below and installs the instantiated unit at
# ~/.config/containers/systemd/devenv-<name>.container. One .container file
# per running container; do NOT edit the installed copies directly.
#
# After install, the operator runs:
#   systemctl --user daemon-reload
#   systemctl --user start devenv-<name>.service
#
# (Quadlet translates each .container into a .service at daemon-reload time.)
#
# Parallel-container safety: every per-container value (ContainerName,
# PublishPort, Volume, EnvironmentFile) is unique per substitution. Two
# instantiations with different ${NAME} produce two non-colliding units.

[Unit]
Description=Remote persistent dev environment (${NAME})
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/remote-persistent-devenv:latest
ContainerName=devenv-${NAME}
PublishPort=${PORT}:22
Volume=devenv-${NAME}-workspace:/workspace
EnvironmentFile=${ENV_FILE}
# UTC unless the .env overrides TZ.
Timezone=UTC

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
