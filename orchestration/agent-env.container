# agent-env.container — Podman Quadlet TEMPLATE for VPS use.
#
# This is a TEMPLATE. The operator substitutes the ${NAME}, ${PORT}, and
# ${ENV_FILE} placeholders below (see docs/orchestration.md) and installs the
# instantiated unit at ~/.config/containers/systemd/agent-env-<name>.container.
# One .container file per running container; do NOT edit the installed copies.
#
# After install, the operator runs:
#   systemctl --user daemon-reload
#   systemctl --user start agent-env-<name>.service
#
# (Quadlet translates each .container into a .service at daemon-reload time.)
#
# Parallel-container safety: every per-container value (ContainerName,
# PublishPort, Volume, EnvironmentFile) is unique per substitution. Two
# instantiations with different ${NAME} produce two non-colliding units.

[Unit]
Description=agent-env — remote persistent dev environment (${NAME})
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/agent-env:latest
ContainerName=agent-env-${NAME}
PublishPort=${PORT}:22
Volume=agent-env-${NAME}-workspace:/workspace
EnvironmentFile=${ENV_FILE}
# UTC unless the .env overrides TZ.
Timezone=UTC

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
