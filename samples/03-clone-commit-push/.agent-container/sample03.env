# Non-secret environment for the container, discovered by name (`<name>.env`).
#
# GH_TOKEN is deliberately NOT here: this sample pushes, so the token is declared
# as a CREDENTIAL LOCATOR in environments.yaml and delivered to the container over
# its own sshd. Putting the real value in this file would commit it.
GIT_USER_NAME=agent-container sample
GIT_USER_EMAIL=sample@example.invalid
