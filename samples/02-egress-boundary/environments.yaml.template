# Feature 006 (agent-as-code) + Feature 012 (egress control).
#
# Copied to <project>/.agent-container/environments.yaml by run.sh, with @NAME@
# and @AGENT@ substituted. The `allow` list is the WHOLE policy: everything not
# named here is refused at the packet level, in a network namespace the agent
# shares with a sidecar that alone holds NET_ADMIN.
#
# Note what is declared WITHOUT a port. An unported destination goes into the
# PROXY allowlist, so the agent's TLS is redirected to squid, which SPLICES it —
# it is never terminated and never inspected, so no plaintext credential is ever
# created inside the component meant to reduce exposure. The name is checked; the
# bytes are not read.
#
# `github.com` is declared alongside the model API because this sample clones and
# pushes. A run that only talked to its model would reach one destination and
# prove much less.
environments:
  - name: "@NAME@"
    host: local
    container:
      agent: "@AGENT@"
    egress:
      allow:
@ALLOW@
