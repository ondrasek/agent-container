# Non-secret environment for the container. Discovered by name
# (`<name>.env` beside the spec) — the spec does not have to point at it.
#
# GH_TOKEN is REQUIRED by the container's entrypoint even for an environment
# that never pushes, so this sample sets an obvious non-value. It is not a
# credential and nothing authenticates with it. Samples that DO push carry a
# real token as a credential locator instead, never as a value in this file.
GIT_USER_NAME=agent-container sample
GIT_USER_EMAIL=sample@example.invalid
GH_TOKEN=unused-by-this-sample
