# agent-env attach hosts config — copy to ~/.config/agent-env/hosts.conf
#
# Flat KEY=VALUE pairs. For each container name `foo`, define FOO_HOST and
# FOO_PORT. The name argument to `agent-env attach` is uppercased (and hyphens
# become underscores) before lookup, so `agent-env attach acme` reads ACME_HOST
# + ACME_PORT, and `agent-env attach my-box` reads MY_BOX_HOST + MY_BOX_PORT.
#
# agent-env PARSES this file line-by-line and never sources/executes it — keep
# it to plain KEY=VALUE scalars. No spaces around `=`; values with `$` or
# backticks are taken literally (no shell expansion).
#
# Recommended permissions: chmod 0600 ~/.config/agent-env/hosts.conf

# One VPS, two containers on different ports:
ACME_HOST=vps1.example.com
ACME_PORT=2231

BLOG_HOST=vps1.example.com
BLOG_PORT=2247

# A second VPS, one container:
SCRATCH_HOST=vps2.example.com
SCRATCH_PORT=2200
