# Copy to .env and fill in real values. .env is gitignored; never commit it.
# See docs/credentials.md for the rationale and security trade-offs.

# --- Git push credential ---
# Two layered channels; pick by the remote's URL scheme (a deploy may carry both).
#
# 1) SSH deploy key (DEFAULT, Feature 003). Preferred: an ephemeral outbound key,
#    injected at runtime and NEVER persisted to a volume (FR-012). Equivalent to
#    `up --push-key FILE --known-hosts FILE`. base64 an UNENCRYPTED private key
#    (`base64 -w0 < ~/.ssh/agent_push_ed25519`); PUSH_KNOWN_HOSTS seeds the remote
#    host identity so the first push doesn't stall on host-key verification.
#    A per-repository deploy key is just a narrower key here (FR-004).
# SSH_PUSH_KEY_B64=
# PUSH_KNOWN_HOSTS="github.com ssh-ed25519 AAAA..."
#
# 2) HTTPS + GitHub PAT (alternative). Create at: https://github.com/settings/tokens
#    Scopes: repo (required), workflow (optional).
GH_TOKEN=

# --- Git identity (not secret) ---
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# --- Agent provider keys ---
# THREE layered delivery paths (see docs/credentials.md); pick per agent:
#  1) File-first (PREFERRED, Feature 003): drop a per-provider key file next to
#     this .env and it is discovered + injected EPHEMERALLY (never persisted):
#       ./agent-container.<name>.<provider>.key   (provider ∈ anthropic|openai|...)
#     Claude reads it via an apiKeyHelper; Codex/pi get an ephemeral $HOME redirect.
#  2) Interactive login inside the container (claude -> /login, codex login) —
#     persists on the per-name credential volume and auto-refreshes; preferred for
#     subscription accounts. (This on-volume persistence is the operator's choice.)
#  3) The env vars below — a layered fallback for agents that read the env.
# All three are OPTIONAL; leave blank to use path 1 or 2.
# Claude Code (API-key billing):
ANTHROPIC_API_KEY=
# Codex (@openai/codex):
OPENAI_API_KEY=
# pi-coding-agent is multi-provider; uncomment the ones you actually use.
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# --- Operator-canonical agent config (OPTIONAL, Feature 003) ---
# Non-secret settings/guidance/tool defs delivered FRESH each deploy (edits
# propagate on redeploy) while agent runtime state persists on its volume.
# No env var: drop files under the convention dir, discovered automatically:
#   ./agent-container.<name>.config/…   (e.g. .claude/settings.json, CLAUDE.md)
# A config file that embeds a secret is treated AS a secret (ephemeral), not
# persisted. See docs/credentials.md "Canonical config vs runtime state".

# --- SSH identity injection (OPTIONAL) ---
# The container is rootless (sshd runs as the dev user on port 2222) and its SSH
# identity persists on the per-container ~/.ssh volume. These let you supply a
# fixed identity via the env-file channel; equivalents exist as `up --host-key /
# --authorized-key` and the `keys` subcommand. See docs/credentials.md.
#
# Public keys allowed to SSH in (newline-separated; non-secret):
# SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA... you@laptop"
# A fixed ed25519 host key so the container's fingerprint is stable/known,
# base64-encoded (`base64 -w0 < ssh_host_ed25519_key`). Keep the .env 0600.
# SSH_HOST_ED25519_KEY_B64=
