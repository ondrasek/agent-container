# Copy to .env and fill in real values. .env is gitignored; never commit it.
# See docs/credentials.md for the rationale and security trade-offs.

# --- GitHub auth (HTTPS push) ---
# Create at: https://github.com/settings/tokens
# Scopes: repo (required), workflow (optional)
GH_TOKEN=

# --- Git identity (not secret) ---
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# --- Agent provider keys ---
# OPTIONAL: leave blank to log in interactively inside the container instead
# (claude -> /login, codex login). Interactive login persists on the container's
# per-name credential volume and auto-refreshes — preferred for subscription
# accounts. See docs/credentials.md and the README "Log in to agents" section.
# Claude Code (API-key billing):
ANTHROPIC_API_KEY=
# Codex (@openai/codex):
OPENAI_API_KEY=
# pi-coding-agent is multi-provider; uncomment the ones you actually use.
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# --- SSH identity injection (OPTIONAL) ---
# The container is rootless (sshd runs as the dev user on port 2222) and its SSH
# identity persists on the per-container ~/.ssh volume. These let you supply a
# fixed identity via the env-file channel; equivalents exist as `up --host-key /
# --authorized-key` and the `keys` subcommand. See docs/credentials.md.
#
# Public keys allowed to SSH in (newline-separated; non-secret):
# SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA... you@laptop"
# A fixed ed25519 host key so the container's fingerprint is stable/known,
# base64-encoded (`base64 -w0 < ssh_host_ed25519_key`). Keep the .env 0600.
# SSH_HOST_ED25519_KEY_B64=
