#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer>=0.12,<1",
#   "questionary>=2.0,<3",
#   "rich>=13,<15",
# ]
# ///
#
# devenv-wiz — interactive wizard + CLI for devenv containers.
#
# Python sibling of bin/devenv and bin/devenv-attach. Shares all on-disk
# state with them: container naming (devenv-<name>), the port hash
# (2200 + sum-of-char-codes mod 100), state files
# ($XDG_STATE_HOME/devenv/<name>.port), env-file resolution
# (./.env -> ~/.config/devenv/<name>.env -> ~/.config/devenv/.env), and
# the hosts.conf KEY=VALUE format (FOO_HOST / FOO_PORT).
#
# ============================================================================
# INTEROP WARNING: constants and pure helpers below are duplicated from
# bin/devenv (and the hosts.conf lookup from bin/devenv-attach).
# Logic duplicated in bin/devenv — change both, or the toolchains diverge.
# ============================================================================
#
# Divergence (documented): bin/devenv-attach *sources* hosts.conf via bash;
# this tool parses it line-by-line and never executes it. Values containing
# `$` or backticks are taken literally, with a one-time warning.

from __future__ import annotations

import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
from pathlib import Path

import questionary
import typer
from rich.console import Console
from rich.table import Table

# --- constants ---------------------------------------------------------------

IMAGE_NAME = "localhost/remote-persistent-devenv:latest"
CONTAINER_PREFIX = "devenv-"
PORT_BASE = 2200
PORT_RANGE = 100  # 2200..2299

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "devenv"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "devenv"
HOSTS_CONF = CONFIG_DIR / "hosts.conf"

REPO_ROOT = Path(__file__).resolve().parent.parent

NAME_RE = re.compile(r"[a-z0-9][a-z0-9_-]*")

console = Console()


def eprint(msg: str) -> None:
    # Plain stderr writer; rich would mangle "[devenv-wiz]" as markup and wrap lines.
    print(msg, file=sys.stderr)


class Fatal(Exception):
    """Fatal error; CLI exits 1, wizard prints and returns to the menu."""


def die(msg: str) -> "typer.NoReturn":  # mirrors bash die()
    raise Fatal(msg)


# --- pure helpers ------------------------------------------------------------


def validate_name(name: str) -> str:
    """Same charset rule as bin/devenv require_name.

    >>> validate_name("acme")
    'acme'
    >>> validate_name("my-box")
    'my-box'
    >>> validate_name("Bad")
    Traceback (most recent call last):
    ...
    Fatal: invalid <name> 'Bad'; must match [a-z0-9][a-z0-9_-]*
    """
    if not name:
        die("missing required <name> argument")
    if not NAME_RE.fullmatch(name):
        die(f"invalid <name> '{name}'; must match [a-z0-9][a-z0-9_-]*")
    return name


def container_name(name: str) -> str:
    """
    >>> container_name("acme")
    'devenv-acme'
    """
    return f"{CONTAINER_PREFIX}{name}"


def volume_name(name: str) -> str:
    """
    >>> volume_name("acme")
    'devenv-acme-workspace'
    """
    return f"{CONTAINER_PREFIX}{name}-workspace"


def port_for_name(name: str) -> int:
    """Deterministic port: PORT_BASE + (sum of char codes mod PORT_RANGE).

    Name charset is ASCII-only (enforced by NAME_RE), so ord() matches
    bash's printf '%d' "'c" exactly.

    >>> port_for_name("acme")
    2206
    >>> port_for_name("my-box")
    2204
    """
    return PORT_BASE + (sum(ord(c) for c in name) % PORT_RANGE)


def name_to_key(name: str) -> str:
    """hosts.conf key prefix: hyphens -> underscores, uppercased.

    >>> name_to_key("my-box")
    'MY_BOX'
    >>> name_to_key("acme")
    'ACME'
    """
    return name.replace("-", "_").upper()


def parse_kv_config(text: str) -> dict[str, str]:
    """Literal KEY=VALUE parser for hosts.conf. Never executes the file.

    Skips blank lines and # comments, strips an optional leading 'export ',
    splits on the first '=', strips one pair of matching quotes.

    >>> parse_kv_config("# c\\n\\nA=1\\nexport B='two'\\nC=\\"three\\"\\nD=a=b\\n")
    {'A': '1', 'B': 'two', 'C': 'three', 'D': 'a=b'}
    """
    out: dict[str, str] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        if key:
            out[key] = value
    return out


def env_file_candidates(name: str, cwd: Path) -> list[Path]:
    """Resolution order is the interop contract with bin/devenv.

    >>> [str(p) for p in env_file_candidates("acme", Path("/w"))][0]
    '/w/.env'
    """
    return [cwd / ".env", CONFIG_DIR / f"{name}.env", CONFIG_DIR / ".env"]


def resolve_env_file(name: str) -> Path | None:
    # Secret hygiene: only existence checks; contents are never read.
    for candidate in env_file_candidates(name, Path.cwd()):
        if candidate.is_file():
            return candidate
    return None


def state_file(name: str) -> Path:
    return STATE_DIR / f"{name}.port"


# --- runtime -----------------------------------------------------------------

_hosts_warned = False


def detect_runtime() -> str:
    forced = os.environ.get("DEVENV_RUNTIME")
    if forced:
        if forced not in ("podman", "docker"):
            die(f"DEVENV_RUNTIME must be 'docker' or 'podman', got: {forced}")
        if not shutil.which(forced):
            die(f"DEVENV_RUNTIME={forced} but '{forced}' is not on PATH")
        return forced
    if shutil.which("podman"):
        return "podman"
    if shutil.which("docker"):
        return "docker"
    die("neither 'podman' nor 'docker' on PATH (install one, or set DEVENV_RUNTIME)")


def query(argv: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True)


def container_running(rt: str, cname: str) -> bool:
    r = query([rt, "ps", "--filter", f"name=^{cname}$", "--format", "{{.Names}}"])
    return cname in r.stdout.splitlines()  # exact match, mirrors grep -qx


def container_exists(rt: str, cname: str) -> bool:
    r = query([rt, "ps", "-a", "--filter", f"name=^{cname}$", "--format", "{{.Names}}"])
    return cname in r.stdout.splitlines()


def image_exists(rt: str, tag: str) -> bool:
    # `image inspect` works on both podman and docker (podman's `image exists` does not).
    return query([rt, "image", "inspect", tag]).returncode == 0


def port_free(port: int) -> bool:
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.bind(("127.0.0.1", port))
        return True
    except OSError:
        return False


def write_state(name: str, port: int) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state_file(name).write_text(f"{port}\n")


def read_state_port(name: str) -> str | None:
    f = state_file(name)
    if not f.is_file():
        return None
    return f.read_text().strip() or None


def clear_state(name: str) -> None:
    state_file(name).unlink(missing_ok=True)


def load_hosts_conf() -> dict[str, str]:
    global _hosts_warned
    if not HOSTS_CONF.is_file():
        return {}
    conf = parse_kv_config(HOSTS_CONF.read_text())
    if not _hosts_warned and any("$" in v or "`" in v for v in conf.values()):
        eprint(
            "[devenv-wiz] WARNING: hosts.conf contains '$' or '`' values; "
            "devenv-wiz does not perform shell expansion (bin/devenv-attach does)."
        )
        _hosts_warned = True
    return conf


def hosts_entry(name: str) -> tuple[str, str] | None:
    """(host, port) from hosts.conf, or None unless BOTH keys are present."""
    conf = load_hosts_conf()
    key = name_to_key(name)
    host, port = conf.get(f"{key}_HOST"), conf.get(f"{key}_PORT")
    if host and port:
        return host, port
    return None


def quadlet_active(name: str) -> bool:
    # Best-effort probe; systemctl is absent on macOS — ignore all failures.
    if not shutil.which("systemctl"):
        return False
    try:
        r = query(["systemctl", "--user", "is-active", f"{container_name(name)}.service"])
        return r.returncode == 0 and r.stdout.strip() == "active"
    except Exception:
        return False


def is_tty() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


# --- commands ----------------------------------------------------------------


def log(msg: str) -> None:
    eprint(f"[devenv-wiz] {msg}")


def warn(msg: str) -> None:
    eprint(f"[devenv-wiz] WARNING: {msg}")


def hint(cmd: str) -> None:
    console.print(f"hint: {cmd}", style="dim")


def do_build(tag: str) -> None:
    rt = detect_runtime()
    log(f"building image '{tag}' with {rt} from {REPO_ROOT}")
    # Inherited stdio: layer progress must stream, never capture.
    rc = subprocess.run([rt, "build", "-t", tag, str(REPO_ROOT)]).returncode
    if rc != 0:
        die(f"build failed (exit {rc})")


def launch_container(rt: str, name: str, env_file: Path) -> None:
    """Start argv must match bin/devenv cmd_up flag-for-flag."""
    cname, vname, port = container_name(name), volume_name(name), port_for_name(name)
    if not port_free(port):
        die(
            f"port {port} on 127.0.0.1 is already in use (port = 2200 + name hash; "
            f"collisions are possible). Stop whatever holds it (devenv-wiz list) "
            f"or pick a different name."
        )
    log(f"name={name} port={port} env-file={env_file}")
    log(f"image={IMAGE_NAME} volume={vname}")
    r = query([
        rt, "run", "-d",
        "--name", cname,
        "--env-file", str(env_file),
        "-p", f"{port}:22",
        "-v", f"{vname}:/workspace",
        "--restart", "unless-stopped",
        IMAGE_NAME,
    ])
    if r.returncode != 0:
        die(f"{rt} run failed: {r.stderr.strip()}")
    write_state(name, port)
    log(f"started {cname}; attach with: devenv-wiz attach {name}")
    log(f"or directly: ssh dev@localhost -p {port} -t tmux attach -t main")


def do_up(name: str, env_file_override: Path | None = None) -> None:
    validate_name(name)
    rt = detect_runtime()
    cname = container_name(name)

    if container_running(rt, cname):
        port = read_state_port(name)
        log(f"container {cname} already running" + (f" on port {port}" if port else ""))
        log(f"attach with: devenv-wiz attach {name}")
        return

    if container_exists(rt, cname):
        die(f"container {cname} exists but is not running. Run: devenv-wiz down {name}")

    env_file = env_file_override or resolve_env_file(name)
    if env_file is None:
        cands = ", ".join(str(c) for c in env_file_candidates(name, Path.cwd()))
        die(f"no .env found. Looked in: {cands}")

    if not image_exists(rt, IMAGE_NAME):
        die(f"image {IMAGE_NAME} not found; run: devenv-wiz build")

    launch_container(rt, name, env_file)


def down_container(rt: str, name: str, purge: bool) -> None:
    cname, vname = container_name(name), volume_name(name)
    if container_exists(rt, cname):
        log(f"stopping {cname}")
        query([rt, "stop", cname])
        log(f"removing {cname}")
        query([rt, "rm", "-f", cname])
    else:
        log(f"no container named {cname}")

    if purge:
        log(f"purging volume {vname}")
        if query([rt, "volume", "rm", vname]).returncode != 0:
            warn(f"volume {vname} not removed (in use or absent)")
    else:
        log(f"volume {vname} preserved (use --purge to remove)")

    clear_state(name)


def cli_down(name: str, purge: bool, yes: bool) -> None:
    validate_name(name)
    rt = detect_runtime()

    if quadlet_active(name):
        warn(
            f"systemd user unit {container_name(name)}.service is active; "
            f"systemd will restart the container after removal. Manage it via Quadlet instead."
        )
        if not yes:
            eprint("[devenv-wiz] re-run with -y/--yes to proceed despite the active unit")
            raise typer.Exit(2)

    if not yes:
        if not is_tty():
            eprint("[devenv-wiz] refusing destructive 'down' without -y/--yes on a non-TTY")
            raise typer.Exit(2)
        what = f"stop and remove {container_name(name)}"
        if purge:
            what += f" and DELETE volume {volume_name(name)}"
        if not questionary.confirm(f"{what}?", default=False).ask():
            log("aborted")
            return

    down_container(rt, name, purge)


def gather_rows(rt: str) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    running_short: set[str] = set()
    r = query([rt, "ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.RunningFor}}"])
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 4 or not parts[0].startswith(CONTAINER_PREFIX):
            continue
        cname, image, status, uptime = parts
        short = cname[len(CONTAINER_PREFIX):]
        running_short.add(short)
        rows.append({
            "name": cname,
            "port": read_state_port(short) or "?",
            "image": image,
            "status": status,
            "uptime": uptime,
            "stale": False,
        })
    # Orphaned state files: a <name>.port with no running container.
    if STATE_DIR.is_dir():
        for f in sorted(STATE_DIR.glob("*.port")):
            short = f.stem
            if short in running_short:
                continue
            rows.append({
                "name": container_name(short),
                "port": read_state_port(short) or "?",
                "image": "-",
                "status": "stale",
                "uptime": "-",
                "stale": True,
            })
    return rows


def do_list(as_json: bool) -> None:
    rt = detect_runtime()
    rows = gather_rows(rt)
    if as_json:
        print(json.dumps(rows, indent=2))
        return
    table = Table(show_header=True, header_style="bold", box=None, pad_edge=False)
    for col in ("NAME", "PORT", "IMAGE", "STATUS", "UPTIME"):
        table.add_column(col)
    for row in rows:
        style = "dim" if row["stale"] else None
        table.add_row(
            str(row["name"]), str(row["port"]), str(row["image"]),
            str(row["status"]), str(row["uptime"]), style=style,
        )
    console.print(table)


def do_logs(name: str, follow: bool) -> int:
    validate_name(name)
    rt = detect_runtime()
    argv = [rt, "logs"] + (["-f"] if follow else []) + [container_name(name)]
    try:
        return subprocess.run(argv).returncode  # inherited stdio
    except KeyboardInterrupt:
        return 130


# --- wizard ------------------------------------------------------------------

# (added in subsequent increments)


def wizard_loop() -> int:
    eprint("[devenv-wiz] wizard not implemented yet; use subcommands (--help)")
    return 2


# --- entry -------------------------------------------------------------------

app = typer.Typer(
    add_completion=False,
    no_args_is_help=False,
    pretty_exceptions_enable=False,
    help="Interactive wizard + CLI for devenv containers (sibling of bin/devenv).",
)


def fatal_exit(e: Fatal) -> "typer.NoReturn":
    eprint(f"[devenv-wiz] FATAL: {e}")
    raise typer.Exit(1)


def run_self_test() -> int:
    import doctest

    failures, tests = doctest.testmod(
        sys.modules[__name__], optionflags=doctest.IGNORE_EXCEPTION_DETAIL
    )
    # Corpus computed from bin/devenv's bash port_for_name (hard-coded truth).
    corpus = {
        "acme": 2206,
        "blog": 2220,
        "scratch": 2244,
        "my-box": 2204,
        "a": 2297,
        "devbox123": 2298,
    }
    bad = {n: (port_for_name(n), want) for n, want in corpus.items() if port_for_name(n) != want}
    keys_ok = name_to_key("my-box") == "MY_BOX" and name_to_key("acme") == "ACME"
    ok = failures == 0 and not bad and keys_ok
    print(f"doctests: {tests - failures}/{tests} passed")
    print(f"port corpus: {'ok' if not bad else f'MISMATCH {bad}'}")
    print(f"key derivation: {'ok' if keys_ok else 'MISMATCH'}")
    print("self-test:", "PASS" if ok else "FAIL")
    return 0 if ok else 1


@app.command()
def build(
    tag: str = typer.Argument(IMAGE_NAME, help="Image tag to build."),
) -> None:
    """Build the image at the repo root (streams build output)."""
    do_build(tag)


@app.command()
def up(
    name: str = typer.Argument(..., help="Container short name (devenv-<name>)."),
    env_file: Path | None = typer.Option(
        None, "--env-file", help="Bypass env-file resolution; path must exist."
    ),
) -> None:
    """Start container devenv-NAME (detached)."""
    if env_file is not None and not env_file.is_file():
        raise typer.BadParameter(f"--env-file {env_file} does not exist")
    do_up(name, env_file)


@app.command()
def down(
    name: str = typer.Argument(..., help="Container short name."),
    purge: bool = typer.Option(False, "--purge", help="Also delete the workspace volume."),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip confirmation."),
) -> None:
    """Stop and remove container devenv-NAME."""
    cli_down(name, purge, yes)


@app.command()
def purge(
    name: str = typer.Argument(..., help="Container short name."),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip confirmation."),
) -> None:
    """Sugar for: down NAME --purge."""
    cli_down(name, purge=True, yes=yes)


@app.command(name="list")
def list_cmd(
    as_json: bool = typer.Option(False, "--json", help="Emit machine-readable JSON."),
) -> None:
    """List running devenv containers (plus stale state files)."""
    do_list(as_json)


@app.command()
def logs(
    name: str = typer.Argument(..., help="Container short name."),
    no_follow: bool = typer.Option(False, "--no-follow", help="Print logs without following."),
) -> None:
    """Tail container logs."""
    raise typer.Exit(do_logs(name, follow=not no_follow))


@app.callback(invoke_without_command=True)
def main(
    ctx: typer.Context,
    self_test: bool = typer.Option(False, "--self-test", help="Run doctests + interop corpus checks."),
) -> None:
    if self_test:
        raise typer.Exit(run_self_test())
    if ctx.invoked_subcommand is not None:
        return
    if not is_tty():
        eprint("[devenv-wiz] no TTY; interactive wizard unavailable. Use subcommands (devenv-wiz --help).")
        raise typer.Exit(2)
    raise typer.Exit(wizard_loop())


if __name__ == "__main__":
    try:
        app()
    except Fatal as e:
        eprint(f"[devenv-wiz] FATAL: {e}")
        sys.exit(1)
