#!/usr/bin/env bash
# devenv-attach — client-side helper that resolves a container name to the
# right ssh + tmux invocation.
#
# Usage:
#   devenv-attach <name>     Attach to a remote container by symbolic name.
#                            Reads host + port from ~/.config/devenv/hosts.conf
#                            (or $XDG_CONFIG_HOME/devenv/hosts.conf).
#   devenv-attach -l <name>  Attach to a local container by name. Reads the
#   devenv-attach --local <name>
#                            port from $XDG_STATE_HOME/devenv/<name>.port
#                            (the state file written by `bin/devenv up`).
#
# Hosts config format (~/.config/devenv/hosts.conf):
#   Flat KEY=VALUE pairs, sourced by Bash. For each container name `FOO`,
#   define FOO_HOST and FOO_PORT. Names are uppercased before lookup.
#   See docs/devenv-hosts.example for a working template.
#
# Hard constraints respected:
#   - No state written anywhere except $XDG_CONFIG_HOME / $XDG_STATE_HOME.
#   - No dependency on bin/devenv at runtime — this script reads files only.
#   - Detach (Ctrl+B d) returns to the local shell because ssh runs with -t
#     and we `exec` it so signals + exit code propagate.

set -euo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devenv"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devenv"
readonly HOSTS_CONF="${CONFIG_DIR}/hosts.conf"

# tmux window names are embedded in the ssh remote command (--window), so they
# are charset-validated before use (matches the entrypoint window charset).
readonly WINDOW_RE='^[A-Za-z0-9._-]+$'

die() { printf 'devenv-attach: %s\n' "$*" >&2; exit 1; }

usage() {
    cat >&2 <<'EOF'
usage: devenv-attach [-w NAME] <name>            # attach to a remote container by name
       devenv-attach -l|--local [-w NAME] <name> # attach to a local container by name

  -w, --window NAME  Select tmux window NAME (in session 'main') before attaching.

Remote config: ~/.config/devenv/hosts.conf (KEY=VALUE; see docs/devenv-hosts.example)
Local state:   $XDG_STATE_HOME/devenv/<name>.port (written by bin/devenv up)

env overrides:
  DEVENV_USER=<user>  SSH user (default: dev)
EOF
}

# Build + exec the ssh attach for a resolved target. With a window name the
# remote command is a SINGLE compound string: select-window (tolerating a
# missing window) THEN attach. Without one, the exact legacy argv is preserved.
exec_attach() {
    local user="$1" host="$2" port="$3" window="$4"
    if [[ -n "${window}" ]]; then
        printf 'devenv-attach: %s@%s:%s (tmux session "main", window "%s")\n' \
            "${user}" "${host}" "${port}" "${window}" >&2
        exec ssh "${user}@${host}" -p "${port}" -t \
            "tmux select-window -t main:${window} 2>/dev/null; exec tmux attach -t main"
    fi
    printf 'devenv-attach: %s@%s:%s (tmux session "main")\n' "${user}" "${host}" "${port}" >&2
    exec ssh "${user}@${host}" -p "${port}" -t tmux attach -t main
}

# Normalise a container name to the prefix used in hosts.conf keys:
# uppercase, hyphens -> underscores. Lowercase shape is enforced by bin/devenv,
# but we accept either here.
name_to_key() {
    local n="$1"
    n="${n//-/_}"
    printf '%s' "${n}" | tr '[:lower:]' '[:upper:]'
}

attach_remote() {
    local name="$1" window="${2:-}"
    local key host_var port_var host port user="${DEVENV_USER:-dev}"

    [[ -f "${HOSTS_CONF}" ]] || die "no hosts config at ${HOSTS_CONF} — create it (see docs/devenv-hosts.example)"

    key="$(name_to_key "${name}")"
    host_var="${key}_HOST"
    port_var="${key}_PORT"

    # shellcheck disable=SC1090
    set -a; source "${HOSTS_CONF}"; set +a

    host="${!host_var:-}"
    port="${!port_var:-}"

    if [[ -z "${host}" || -z "${port}" ]]; then
        die "no host configured for ${name} — add ${host_var} and ${port_var} to ${HOSTS_CONF} (see docs/devenv-hosts.example)"
    fi

    exec_attach "${user}" "${host}" "${port}" "${window}"
}

attach_local() {
    local name="$1" window="${2:-}"
    local port_file port user="${DEVENV_USER:-dev}"

    port_file="${STATE_DIR}/${name}.port"
    if [[ ! -f "${port_file}" ]]; then
        die "no local state for ${name} at ${port_file} — is the container running? (try: bin/devenv up ${name})"
    fi
    port="$(cat "${port_file}")"
    [[ -n "${port}" ]] || die "state file ${port_file} is empty"

    exec_attach "${user}" "localhost" "${port}" "${window}"
}

main() {
    local mode=remote name="" window=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--local) mode=local; shift ;;
            -w|--window)
                shift
                [[ $# -gt 0 ]] || die "--window requires a NAME"
                window="$1"; shift ;;
            --window=*) window="${1#--window=}"; shift ;;
            -h|--help|help) usage; exit 0 ;;
            --) shift; name="${1:-}"; shift || true; break ;;
            -*) die "unknown flag: $1 (run 'devenv-attach --help')" ;;
            *)  name="$1"; shift ;;
        esac
    done

    [[ -n "${name}" ]] || { usage; exit 2; }
    # Validate BEFORE building the remote command (window is embedded in a
    # remote shell string; a bad value must never reach ssh).
    if [[ -n "${window}" ]]; then
        [[ "${window}" =~ ${WINDOW_RE} ]] \
            || die "invalid --window '${window}'; must match [A-Za-z0-9._-]+"
    fi

    case "${mode}" in
        remote) attach_remote "${name}" "${window}" ;;
        local)  attach_local  "${name}" "${window}" ;;
    esac
}

main "$@"
