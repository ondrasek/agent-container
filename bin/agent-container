def ssh_key_show(
    name: str = typer.Argument(..., help="Container short name."),
    as_json: bool = JSON_OPT,
) -> None:
    """Print the agent's SSH PUBLIC key, for registering on a remote."""
    set_json_mode(as_json)
    do_ssh_key_show(name, as_json)


