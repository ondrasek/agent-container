    as_json: bool = JSON_OPT,
) -> None:
    """Start a stopped agent-container-NAME (no rebuild, no recreate)."""
    set_json_mode(as_json)
    do_start(name, host)
    emit_action("start", name=name, host=host)


@app.command()
def redeploy(
    name: str = typer.Argument(..., help="Container short name."),
    host: str | None = typer.Option(None, "--host", help="Host the container runs on."),
    env_file: list[Path] = typer.Option(
        None,
        "-e",
        "--env-file",
        help="Env file to load; repeatable, applied in order (later wins). "
        "Bypasses env-file resolution; each path must exist.",
    ),
    mount: list[str] = typer.Option(
        None, "--mount", help="Bind-mount a host dir (repeatable), as for `up`."
    ),
    host_key: Path | None = typer.Option(
        None,
        "--host-key",
        hidden=True,
        help="REMOVED (Feature 018). Host identity is captured, not supplied.",
    ),
    authorized_key: list[Path] = typer.Option(
        None, "--authorized-key", help="Inject an SSH public key (repeatable)."
    ),
    push_key: Path | None = typer.Option(
        None,
        "--push-key",
        hidden=True,
        help="REMOVED (Feature 019). The agent generates its own key; register the public half.",
    ),
    known_hosts: Path | None = typer.Option(
        None, "--known-hosts", help="Inject known_hosts for the push remote (as for `up`)."
    ),
    # None-defaulted, unlike `up`: the default has to mean "not typed" so it can be
    # told apart from an explicit `--mode interactive`, which is how a field gets RESET
    # rather than inherited. The ExecSpec default fills in when there is nothing live.
    mode: str | None = typer.Option(
        None, "--mode", help="Execution mode (as for `up`). Inherited when omitted."
    ),
    agent: str | None = typer.Option(
        None, "--agent", help="Primary agent (as for `up`). Inherited when omitted."
    ),
    # Restated, not delegated to `up`: this is a second place a task is typed, and
    # "as for `up`" is not read by someone who is about to paste one here.
    task: str | None = typer.Option(
        None,
        "--task",
        help="Initial/headless task (as for `up`). RECORDED VERBATIM in the run "
        "record, which outlives the container — never put a credential in it.",
    ),
    workspace: str | None = typer.Option(
        None, "--workspace", help="Workspace mode (as for `up`). Inherited when omitted."
    ),
    workspace_dir: str | None = typer.Option(
        None, "--workspace-dir", help="Host dir for a bind workspace (as for `up`)."
    ),
    repo: str | None = typer.Option(
        None, "--repo", help="Clone-on-start URL (as for `up`). Inherited when omitted."
    ),
    no_repo: bool = typer.Option(False, "--no-repo", help="Drop the inherited clone-on-start URL."),
    foreground: bool = typer.Option(
        False, "--foreground", help="Headless: stream the run attached (as for `up`)."
    ),
    as_json: bool = JSON_OPT,
) -> None:
    """Rebuild the image and recreate agent-container-NAME, preserving its volumes.
    Deliberately non-idempotent: always rebuilds + recreates, even with no change.
    May change mode/agent/workspace/repo. The clone URL is KEPT unless --repo
    replaces it or --no-repo drops it."""
    set_json_mode(as_json)
    if repo is not None and no_repo:
        # Contradictory rather than merely redundant, and guessing which one was meant
        # gets it wrong half the time — on the half where the operator wanted the repo
        # gone, keeping it re-clones into a workspace they were clearing.
        raise typer.BadParameter("--repo and --no-repo are mutually exclusive")
    if push_key is not None:
        refuse_removed_push_key("redeploy --push-key")
    if host_key is not None:
        refuse_removed_host_key("redeploy --host-key")
    for _ef in env_file or []:  # FR-001d: each named file must exist — fail fast
        if not _ef.is_file():
            raise typer.BadParameter(f"--env-file {_ef} does not exist")
    # What the operator did NOT type is what may be inherited. Computed here, where
    # "typed" is still knowable — one layer down every field already has a value and
    # the distinction is gone.
    typed = {f for f, v in (("mode", mode), ("agent", agent), ("workspace", workspace),
                            ("repo", repo)) if v is not None}  # fmt: skip
    defaults = ExecSpec()
    spec = ExecSpec(
        mode=mode or defaults.mode,
        agent=agent or defaults.agent,
        task=resolve_task(task),
        repo=repo,
        workspace=workspace or defaults.workspace,
        workspace_dir=workspace_dir,
        foreground=foreground,
    )
    do_redeploy(
        name,
        host,
        env_file,
        mount or [],
        authorized_key or [],
        known_hosts,
        spec=spec,
        drop_repo=no_repo,
        inherit=INHERITABLE - typed,
    )


@app.command()
def wipe(
    name: str = typer.Argument(..., help="Container short name."),
    host: str | None = typer.Option(None, "--host", help="Host the container runs on."),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip confirmation."),
    as_json: bool = JSON_OPT,
) -> None:
    """WIPE agent-container-NAME: remove the container, its volumes, AND its built image (confirmed)."""
    set_json_mode(as_json)
    do_wipe(name, yes, host)
    emit_action("wipe", name=name, host=host)


@app.command()
def purge(
    name: str = typer.Argument(..., help="Container short name."),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip confirmation."),
    host: str | None = typer.Option(None, "--host", help="Host the environment runs on."),
    as_json: bool = JSON_OPT,
) -> None:
    """Sugar for: down NAME --purge."""
    set_json_mode(as_json)
    # `--host` FORWARDED, not dropped. `cli_down` has always taken a host; `purge`
    # simply never passed one, so the sugar silently targeted the local runtime
    # while `down --host` targeted the remote. A remote environment therefore had
    # no purge at all — the one command that removes CREDENTIAL volumes.
    cli_down(name, purge=True, yes=yes, host=host)
    emit_action("purge", name=name)


# NAMING CONVENTION for group verbs, settled after `inventory list` and `host ls`
# were found to be a coin flip rather than a rule:
#
#   READ verbs are SHORT   — `ls`, because it is typed constantly and every
#                            operator already knows it from the shell.
#   DESTRUCTIVE verbs are SPELLED OUT — `remove`, matching the root's `down`,
#                            `destroy`, `purge`, `wipe`. An abbreviation makes a
#                            dangerous command easier to type by accident, and
#                            these are the commands where a typo costs something.
#
# The previous spellings stay registered as HIDDEN aliases, so no script and no
# muscle memory breaks; they are simply not what --help teaches.
@app.command(name="ls")
@app.command(name="list", hidden=True)
def list_cmd(
    as_json: bool = typer.Option(False, "--json", help="Emit machine-readable JSON."),
    local_only: bool = typer.Option(
        False,
        "--local",
        help="Skip remote round-trips: list only the local runtime + per-host state files (fast).",
    ),
) -> None:
    """List agent-container containers, reconciled live against each registered
    host (a --local view skips remote queries)."""
    set_json_mode(as_json)
    do_list(as_json, local_only)


# The `runs` group reads the DURABLE record store, not the host. It is a group and
# not a top-level `runs` verb for the same reason `host` is: `list` and `show` mean
# different things here than they do for containers, and flattening them would give
# the tool two `list`s that answer different questions. Deliberately read-only —
# there is no `runs rm`; retention prunes at ingestion (FR-011), so a record's
# lifetime is a documented rule rather than an operator action that could be
# forgotten on one machine and not another.
runs_app = typer.Typer(
    no_args_is_help=True,
    # The retention rule is stated HERE, in the help an operator reads at the point
    # of use, and interpolated from the constants that enforce it — a number typed
    # into prose beside a different number in the code is this project's recurring
    # defect, and a test binds these two together in both directions.
    help=(
        "Durable run records: what each run did and how it ended (survives teardown). "
        f"Records are pruned at ingestion, per environment, at "
        f"{RETENTION_MAX_AGE_DAYS} days or {RETENTION_MAX_RECORDS} records — "
        f"whichever prunes first, with the count spent on distinct UTC days first, so "
        f"one night of restart records cannot evict the history that explains it."
    ),
)
app.add_typer(runs_app, name="runs")


@app.command()
def revoke(
    name: str = typer.Argument(..., help="Control-plane environment whose key to withdraw."),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip confirmation."),
    as_json: bool = JSON_OPT,
) -> None:
    """Withdraw a control plane's public key from every host that trusts it.

    ONE COMMAND, NOT N HOSTS (FR-008). The key IS the boundary — the declared
    scope is intent and cannot constrain reach — so this is the only concrete
    narrowing there is.

    The container is left running and untouched: revoking access and destroying
    an environment are different decisions, and doing both here would make the
    safe action expensive.

    Exits non-zero if ANY host could not be confirmed. "Mostly revoked" is
    worthless: an operator who believes a key is gone while a host still trusts
    it stops looking.
    """
    set_json_mode(as_json)
    do_revoke(name, yes, as_json)


telemetry_app = typer.Typer(
    no_args_is_help=True,
    help=(
        "The observability trail: attribution records, run records and egress events. "
        "TWO LEGS, ONE PAYLOAD — the local trail is written where the action lands "
        "regardless of any endpoint, and OTLP export is an additional active path. "
        "They are independent, not alternatives, and carry identical payloads."
    ),
)
app.add_typer(telemetry_app, name="telemetry")


# --- Feature 023: the `telemetry stack` subgroup -----------------------------
# A subgroup of `telemetry` rather than a role on `up`, because `up`'s surface —
# agent, task, repo, env-file, egress, credentials, tmux — is meaningless for a
# collector, and because the endpoint you export TO belongs beside the commands
# that export.

stack_app = typer.Typer(
    no_args_is_help=True,
    help=(
        "The THIRD kind of container this tool manages: a telemetry stack. It receives "
        "what Feature 017 exports and displays it. Holds no credentials and runs no "
        "agent, so its EXPOSURE is the security question that replaces them — an "
        "unauthenticated UI showing verbatim task text must not be published by accident."
    ),
)
telemetry_app.add_typer(stack_app, name="stack")


def stack_ready_probe(endpoint: str, timeout: int = 5) -> bool:
    """Has the OTLP ingest ACCEPTED a record?

    LIVENESS IS NOT READINESS (FR-006, research R2). The container reports
    `Up (starting)` for tens of seconds after the port is listening, and accepts
    TCP before the receiver is wired — so a probe that checks either would send
    the operator off to configure an endpoint that drops what it is sent.

    An EMPTY payload is used deliberately: a ready receiver accepts it, it
    creates no data, and it is therefore safe to repeat every second.
    """
    r = query(
        [
            "curl", "-s", "-o", "/dev/null", "-w", "%{http_code}",
            "-m", str(timeout), "-X", "POST", endpoint,
            "-H", "Content-Type: application/json",
            "--data-binary", '{"resourceLogs":[]}',
        ]
    )  # fmt: skip
    return r.returncode == 0 and r.stdout.strip() == "200"


def stack_wait_ready(endpoint: str, budget: int, container: str, host_rec: dict) -> None:
    """Wait for the ingest, and on expiry say WHICH STAGE we were waiting on.

    "Timed out" is three different problems with three different fixes — a slow
    registry, a container that will not start, and an ingest that never opens —
    and a message that cannot tell them apart sends the operator to debug the
    wrong one (FR-006b).
    """
    deadline = time.monotonic() + budget
    saw_container = False
    while time.monotonic() < deadline:
        if stack_ready_probe(endpoint):
            return
        if not saw_container:
            with contextlib.suppress(Fatal, OSError, subprocess.SubprocessError):
                saw_container = container in host_container_names(host_rec, include_stopped=True)
        time.sleep(2)
    stage = (
        "the ingest never accepted a record"
        if saw_container
        else ("the container never appeared — the image may still be pulling, or the pull failed")
    )
    die(
        f"telemetry stack did not become ready within {budget}s: {stage}. "
        f"Raise AGENT_CONTAINER_STACK_READY_TIMEOUT if the image is still downloading, "
        f"or read the container's log for why it is not serving."
    )


def stack_report_endpoint(name: str, ports: dict, binds: list[str], driver: str) -> str:
    """Print how to reach it, in both forms, plus the egress stanza.

    THE TWO ADDRESSES ARE DIFFERENT and printing only one is the feature's
    principal failure mode: on every runtime where a container does not share
    the operator's loopback, the address a human opens and the address an agent
    exports to diverge (FR-013).
    """
    endpoint = stack_container_endpoint(ports["otlp_http"], driver)
    log(f"stack '{name}' bound on: {', '.join(binds)} (exposure resolved, FR-018b)")
    log(f"  UI (yours):            {stack_operator_url('localhost', ports['ui'])}")
    log(f"  otlp_endpoint (agents): {endpoint}")
    log("")
    log("  put this in settings.yaml so environments export into it:")
    log(f"    otlp_endpoint: {endpoint}")
    log("")
    log("  and if an environment ENFORCES egress, it must also declare the collector —")
    log("  export is governed by that declaration and FAILS OPEN, so an undeclared")
    log("  collector yields a green run with no telemetry and no error anywhere:")
    for line in stack_egress_allow_entry(driver, ports["otlp_http"]).rstrip("\n").splitlines():
        log(f"    {line}")
    return endpoint


def stack_write_endpoint_setting(endpoint: str) -> Path:
    """Write `otlp_endpoint` into settings.yaml inside a MANAGED REGION.

    Same idiom as the container's `~/.ssh/config` block and its
    `authorized_keys` region: everything outside the markers is preserved
    byte-for-byte, and the region is REPLACED rather than appended to, so
    running this twice does not leave two endpoints for the reader to choose
    between (FR-011b).

    Opt-in only. Creating a container must not edit the operator's
    configuration as a side effect.
    """
    begin = "# >>> agent-container telemetry (managed) >>>"
    end = "# <<< agent-container telemetry (managed) <<<"
    path = CONFIG_DIR / "settings.yaml"
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.is_file() else ""
    kept, skip = [], False
    for line in text.splitlines():
        if line.strip() == begin:
            skip = True
            continue
        if line.strip() == end:
            skip = False
            continue
        if not skip:
            kept.append(line)
    body = "\n".join(kept).rstrip("\n")
    block = f"{begin}\notlp_endpoint: {endpoint}\n{end}\n"
    path.write_text((body + "\n\n" if body else "") + block)
    return path


# --- The tool's own dashboards (FR-014, FR-017, FR-017a) ---------------------
# Data rather than files: they are versioned with the TOOL, so re-provisioning
# brings an older stack up to the current tool's expectations, and nothing
# tool-versioned lives on a stack-lifetime volume.
#
# TWO CONSTRAINTS FROM MEASUREMENT, both of which produced a broken dashboard
# before they were understood (research R5, R6):
#
#   1. `{agent_container_run_id="X"}` MATCHES NOTHING. The attribute arrives as
#      Loki STRUCTURED METADATA, not an indexed stream label, so it must be a
#      filter AFTER a stream selector. For the same reason the run picker is a
#      TEXTBOX: a query variable over that label renders empty, `$run_id`
#      interpolates to "", every panel filters on the empty string, and the
#      dashboard reads "No Data" while the data is sitting there.
#
#   2. Metric panels may filter only on DATA-POINT attributes. The
#      OTLP->Prometheus conversion keeps `service.*` from the resource and drops
#      the rest, so `agent` and `run_id` are usable only because Feature 017
#      puts them on the point.
#
# AGENT-AGNOSTIC PANELS LEAD (FR-017a). Panels built on fields one agent happens
# to emit render an empty screen for the others and read as breakage; the
# agent-specific ones are labelled so a blank says "this agent does not report
# that" rather than "this is broken".
_STACK_RUN_SEL = '{service_namespace="agent-container"} | agent_container_run_id=`$run_id`'
_LOKI_DS = {"type": "loki", "uid": "loki"}
_PROM_DS = {"type": "prometheus", "uid": "prometheus"}
_LOGS_OPTS = {"showTime": True, "wrapLogMessage": True, "sortOrder": "Descending"}


def _stack_panel(
    title, x, y, w, h, targets, ds, kind="timeseries", unit=None, opts=None, desc=None
):
    p = {
        "title": title, "type": kind, "datasource": ds,
        "gridPos": {"x": x, "y": y, "w": w, "h": h}, "targets": targets,
        "fieldConfig": {"defaults": ({"unit": unit} if unit else {}), "overrides": []},
    }  # fmt: skip
    if opts:
        p["options"] = opts
    if desc:
        p["description"] = desc
    return p


def _loki_q(expr, kind="range"):
    return [{"expr": expr, "refId": "A", "datasource": _LOKI_DS, "queryType": kind}]


def _prom_q(expr, legend="{{agent}}"):
    return [{"expr": expr, "legendFormat": legend, "refId": "A", "datasource": _PROM_DS}]


def _stack_dashboard_fleet() -> dict:
    return {
        "title": "Agent Containers — Fleet",
        "uid": "agent-container-fleet",
        "tags": ["agent-container"],
        "timezone": "browser",
        "time": {"from": "now-6h", "to": "now"},
        "refresh": "30s",
        "schemaVersion": 39,
        "panels": [
            _stack_panel("Records by agent", 0, 0, 12, 8,
                _loki_q('sum by (agent_container_agent) (count_over_time('
                        '{service_namespace="agent-container"} | agent_container_agent != `` [5m]))'),
                _LOKI_DS,
                desc="Every agent, whatever it emits. claude and opencode export their own OTLP; "
                     "codex and pi arrive via their session transcripts."),
            _stack_panel("Memory in use", 12, 0, 12, 8,
                _prom_q("container_memory_usage_bytes", "{{environment}}"), _PROM_DS, unit="bytes"),
            _stack_panel("CPU seconds/s", 0, 8, 12, 8,
                _prom_q("rate(container_cpu_time_seconds_total[5m])", "{{environment}}"), _PROM_DS),
            _stack_panel("Workspace used", 12, 8, 12, 8,
                _prom_q("workspace_disk_used_bytes", "{{environment}}"), _PROM_DS, unit="bytes"),
        ],
    }  # fmt: skip


def _stack_dashboard_run_trace() -> dict:
    return {
        "title": "Agent Containers — Run Trace (correlated)",
        "uid": "agent-container-trace",
        "tags": ["agent-container", "correlation"],
        "timezone": "browser",
        "time": {"from": "now-24h", "to": "now"},
        "schemaVersion": 39,
        "templating": {"list": [{
            # TEXTBOX, not a query variable — see the module comment above.
            "name": "run_id", "label": "run", "type": "textbox", "query": "",
            "current": {"text": "", "value": ""}, "options": [],
            "description": "Paste a run_id from the Recent runs panel.",
        }]},  # fmt: skip
        "panels": [
            _stack_panel("① Recent runs — copy a run_id into the `run` box above", 0, 0, 24, 7,
                _loki_q('{service_name="agent-container"}'), _LOKI_DS, kind="logs", opts=_LOGS_OPTS,
                desc="One record per run, each carrying its run_id, agent and task."),
            _stack_panel("② This run, by agent", 0, 7, 12, 7,
                _loki_q(f"sum by (agent_container_agent) (count_over_time({_STACK_RUN_SEL} [5m]))"),
                _LOKI_DS),
            _stack_panel("② Records (this run)", 12, 7, 6, 7,
                _loki_q(f"sum(count_over_time({_STACK_RUN_SEL} [$__range]))", "instant"),
                _LOKI_DS, kind="stat"),
            _stack_panel("Cost USD — claude only", 18, 7, 6, 7,
                _loki_q(f"sum(max_over_time({_STACK_RUN_SEL} | unwrap cost_usd [$__range]))", "instant"),
                _LOKI_DS, kind="stat", unit="currencyUSD",
                desc="Only Claude Code reports a per-request cost; empty for other agents by design."),
            _stack_panel("③ Container memory during the run", 0, 14, 12, 8,
                _prom_q('container_memory_usage_bytes{run_id="$run_id"}'), _PROM_DS, unit="bytes",
                desc="THE SAME RUN. A slow run and one wedged against its memory limit look "
                     "identical in an agent's own telemetry."),
            _stack_panel("③ Container CPU during the run", 12, 14, 12, 8,
                _prom_q('rate(container_cpu_time_seconds_total{run_id="$run_id"}[2m])'), _PROM_DS),
            _stack_panel("④ Everything this run emitted, in order", 0, 22, 24, 12,
                _loki_q(_STACK_RUN_SEL), _LOKI_DS, kind="logs",
                opts=_LOGS_OPTS | {"sortOrder": "Ascending"},
                desc="Agent events and the tool's own record on one timeline, joined by run_id."),
        ],
    }  # fmt: skip


def _stack_dashboard_host() -> dict:
    return {
        "title": "Agent Containers — Host",
        "uid": "agent-container-host",
        "tags": ["agent-container"],
        "timezone": "browser",
        "time": {"from": "now-6h", "to": "now"},
        "schemaVersion": 39,
        "panels": [
            _stack_panel("Host systemd journal (not run-scoped)", 0, 0, 24, 9,
                _loki_q('{service_name="lima-host"}'), _LOKI_DS, kind="logs", opts=_LOGS_OPTS,
                desc="Shared across runs, so deliberately not filtered by run_id. Requires the "
                     "host collector from contrib/telemetry."),
            _stack_panel("Container processes", 0, 9, 12, 7,
                _prom_q("container_processes_count_ratio", "{{environment}}"), _PROM_DS),
            _stack_panel("Host load (1m)", 12, 9, 12, 7,
                _prom_q("system_cpu_load_average_1m_ratio", "{{service_name}}"), _PROM_DS),
        ],
    }  # fmt: skip


def stack_dashboard_set() -> list[dict]:
    """Built on demand rather than at import: a module-level list would be one
    more thing to keep in sync with the builders."""
    return [_stack_dashboard_fleet(), _stack_dashboard_run_trace(), _stack_dashboard_host()]


def stack_ui_ready(ui_port: int, budget: int = 60) -> bool:
    """Wait for the UI's API, which is NOT ready when the ingest is.

    THE SAME LESSON, ONE LAYER UP. `up` already waits for the OTLP ingest to
    accept a record — and then provisioned dashboards immediately and every one
    of them failed, because this image opens its ingest before its UI. Measured:
    posting the identical payload by hand seconds later returned 200 for all
    three. Two components, two readiness questions; assuming one answers for the
    other is what produced a stack that came up "successfully" with no views.
    """
    deadline = time.monotonic() + budget
    while time.monotonic() < deadline:
        r = query([
            "curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", "5",
            f"http://localhost:{ui_port}/api/health",
        ])  # fmt: skip
        if r.returncode == 0 and r.stdout.strip() == "200":
            return True
        time.sleep(2)
    return False


def stack_provision_dashboards(name: str, ui_port: int) -> tuple[int, list[str]]:
    """Install the tool's dashboards over the UI's HTTP API.

    THE API, NOT A FILE MOUNT. `configs: {file:}` is a daemon-side bind that
    does not cross a remote context, and dashboards must work on a remote host;
    `{content:}` would cross but would then require a REDEPLOY to re-provision,
    which FR-015 forbids.

    Returns (installed, failed_titles). NEVER raises for a dashboard failure: a
    working collector is worth more than its views, so the deploy survives and
    the failure is named (FR-016).
    """
    if not stack_ui_ready(ui_port):
        log(f"WARNING: the UI on port {ui_port} did not answer; dashboards not installed")
        return 0, [d["title"] for d in stack_dashboard_set()]
    installed, failed = 0, []
    for dash in stack_dashboard_set():
        body = json.dumps({"dashboard": dash, "overwrite": True, "folderId": 0})
        r = query([
            "curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", "20",
            "-X", "POST", f"http://localhost:{ui_port}/api/dashboards/db",
            "-H", "Content-Type: application/json", "-d", body,
        ])  # fmt: skip
        if r.returncode == 0 and r.stdout.strip() == "200":
            installed += 1
        else:
            failed.append(dash.get("title", dash.get("uid", "?")))
    if installed:
        log(f"installed {installed} dashboard(s) into '{name}'")
    if failed:
        log(
            f"WARNING: could not install dashboard(s): {', '.join(failed)} — the stack is up regardless"
        )
    return installed, failed


@stack_app.command("up")
def stack_up(
    name: str = typer.Argument(..., help="Stack short name."),
    host: str | None = typer.Option(None, "--host", help="Host to deploy it on."),
    image: str = typer.Option(STACK_IMAGE_DEFAULT, "--image", help="Stack image."),
    exposure: str = typer.Option(
        STACK_EXPOSURE_DEFAULT,
        "--exposure",
        help="loopback | host | network. Default 'host': the host AND its containers.",
    ),
    retention_days: int = typer.Option(
        STACK_RETENTION_DAYS, "--retention-days", help="Retention window."
    ),
    retention_size: str = typer.Option(
        STACK_RETENTION_SIZE, "--retention-size", help="Retention ceiling."
    ),
    set_endpoint: bool = typer.Option(
        False, "--set-endpoint", help="Write otlp_endpoint into settings.yaml (managed region)."
    ),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip the exposure confirmation."),
    as_json: bool = JSON_OPT,
) -> None:
    """Create or start a telemetry stack, and report where to export into it.

    Reports success ONLY once the ingest has ACCEPTED a record. Container
    liveness is not readiness, and saying otherwise sends the operator off to
    configure an endpoint that drops what it is sent (FR-006).
    """
    set_json_mode(as_json)
    validate_name(name)
    if exposure not in STACK_EXPOSURE_LEVELS:
        die(f"unknown exposure level {exposure!r}; choose {', '.join(STACK_EXPOSURE_LEVELS)}")
    host_name, host_rec = resolve_deploy_host(host)
    driver = host_rec.get("driver") or detect_runtime()
    cname = stack_container_name(name)
    ports = stack_ports_for_name(name)
    binds = stack_exposure_binds(exposure, driver)

    # STATED BEFORE ANYTHING IS CREATED, and refused without consent on a
    # non-TTY. `network` publishes an unauthenticated UI that displays verbatim
    # agent task text, and an ingest that accepts records from anyone who can
    # reach it. Printed rather than prompted: `up` is a path an agent may drive,
    # and a prompt would be auto-answered, which reads as consent (FR-019).
    if exposure == STACK_EXPOSURE_NETWORK:
        log("")
        log("  EXPOSURE: network — this publishes, to every machine that can route here:")
        log("    * a Grafana UI with NO AUTHENTICATION")
        log("    * which displays VERBATIM AGENT TASK TEXT (exported by default, Feature 017)")
        log("    * and an OTLP ingest that ACCEPTS RECORDS FROM ANYONE who can reach it")
        log("")
        if not yes:
            if not is_tty():
                die("refusing --exposure network without -y/--yes on a non-TTY")
            if not questionary.confirm("Publish it anyway?", default=False).ask():
                die("aborted")

    assert_stack_name_free(name, host_rec)

    existing = set()
    with contextlib.suppress(Fatal, OSError, subprocess.SubprocessError):
        existing = host_container_names(host_rec, include_stopped=True)
    running = set()
    with contextlib.suppress(Fatal, OSError, subprocess.SubprocessError):
        running = host_container_names(host_rec, include_stopped=False)

    endpoint = stack_container_endpoint(ports["otlp_http"], driver)
    probe = stack_operator_probe_endpoint(ports["otlp_http"])
    if cname in running:
        log(f"telemetry stack '{name}' is already running on {host_name}")
        stack_report_endpoint(name, ports, binds, driver)
        emit_action("telemetry-stack-up", name=name, host=host_name, created=False)
        return

    # EXISTS BUT STOPPED: start it and KEEP ITS DATA. A host reboot is the
    # ordinary way a stack becomes stopped, and recovering from it must not cost
    # the trail the stack exists to hold (FR-007).
    restarted = cname in existing

    model = build_stack_compose_model(name, image, ports, binds, retention_days, retention_size)
    compose_path = write_compose_file(host_name, f"stack-{name}", model)
    project = f"{STACK_CONTAINER_PREFIX}{name}"

    log(f"{'restarting' if restarted else 'creating'} telemetry stack '{name}' on {host_name}")
    if not restarted:
        log(f"pulling {image} (this is the slow part on a first run)")
    rc = run_child(driver_compose_argv(host_rec, project, compose_path, "up", "-d")).returncode
    if rc != 0:
        die(
            f"could not start the telemetry stack (compose exited {rc}). If a port is "
            f"already taken, pick another name or free {', '.join(str(p) for p in ports.values())}."
        )

    budget = int(os.environ.get("AGENT_CONTAINER_STACK_READY_TIMEOUT", STACK_READY_TIMEOUT))
    log(f"waiting up to {budget}s for the ingest to ACCEPT a record (liveness is not readiness)")
    stack_wait_ready(probe, budget, cname, host_rec)
    log(f"telemetry stack '{name}' is {'restarted' if restarted else 'up'} and accepting records")

    stack_apply_retention_report(name, host_rec, retention_days, retention_size)
    stack_report_endpoint(name, ports, binds, driver)
    if set_endpoint:
        written = stack_write_endpoint_setting(endpoint)
        log(
            f"wrote otlp_endpoint into {written} (managed region; the rest of the file is untouched)"
        )

    with contextlib.suppress(Exception):
        stack_provision_dashboards(name, ports["ui"])

    if not restarted:
        with contextlib.suppress(Exception):
            write_inventory_entry(
                build_inventory_entry(
                    name, host_name, host_provisioned=False, role=KIND_TELEMETRY_STACK
                )
            )
    emit_action("telemetry-stack-up", name=name, host=host_name, created=not restarted)


def stack_apply_retention_report(name: str, host_rec: dict, days: int, size: str) -> None:
    """Read the applied retention BACK, and say so when it cannot be confirmed.

    Research R3: the variable names an image honours must be READ OFF THE IMAGE
    rather than assumed, because a name it does not recognise sets nothing — and
    the stack then retains forever while looking configured. So the value is
    read back rather than trusted.

    UNCONFIRMED IS REPORTED AS UNCONFIRMED, never as the value requested
    (FR-025c). A number nobody verified is exactly how an unbounded store looks
    bounded. The deploy is NOT failed over it: a collector that works beats no
    collector, which is the same rule dashboard failure already follows.
    """
    cname = stack_container_name(name)
    r = query(driver_runtime_argv(host_rec) + ["exec", cname, "env"])
    seen = r.stdout if r.returncode == 0 else ""
    if f"AGENT_CONTAINER_STACK_RETENTION_DAYS={days}" in seen:
        log(f"retention: {days}d / {size} (confirmed)")
        return
    log(
        f"WARNING: could not confirm retention on '{name}'. Asked for {days}d / {size}; "
        f"the container did not report it back. The store may grow without bound — check "
        f"the image's retention settings before leaving this stack running."
    )


@stack_app.command("url")
def stack_url(
    name: str = typer.Argument(..., help="Stack short name."),
    host: str | None = typer.Option(None, "--host", help="Host it runs on."),
    as_json: bool = JSON_OPT,
) -> None:
    """How to reach it: the UI, the endpoint agents export to, and — when the UI
    is not reachable from here — the command that makes it so."""
    set_json_mode(as_json)
    validate_name(name)
    host_name, host_rec = resolve_deploy_host(host)
    driver = host_rec.get("driver") or detect_runtime()
    cname = stack_container_name(name)
    ports = stack_ports_for_name(name)

    running = None
    with contextlib.suppress(Fatal, OSError, subprocess.SubprocessError):
        running = cname in host_container_names(host_rec, include_stopped=False)
    if running is False:
        # NOT RUNNING IS SAID, not papered over with an address that answers
        # nothing — the operator would otherwise debug a URL rather than a stack.
        die(
            f"telemetry stack '{name}' is not running on {host_name} (start it: telemetry stack up {name})"
        )
    if running is None:
        log(
            f"WARNING: could not reach {host_name} to confirm '{name}' is running; the addresses below are what it WOULD use"
        )

    endpoint = stack_container_endpoint(ports["otlp_http"], driver)
    if as_json:
        emit_json({
            "name": name, "host": host_name,
            "ui": stack_operator_url("localhost", ports["ui"]),
            "otlp_endpoint": endpoint,
            "egress_allow": stack_egress_allow_entry(driver, ports["otlp_http"]),
        })  # fmt: skip
        return
    stack_report_endpoint(name, ports, stack_exposure_binds(STACK_EXPOSURE_DEFAULT, driver), driver)

    # THE TUNNEL, when the UI is not reachable from here. A remote host is
    # reached through an ssh:// context, so the address is already known —
    # `address_from_context` exists for exactly this (FR-012).
    ctx = host_rec.get("context") or ""
    if ctx.startswith("ssh://"):
        addr = address_from_context(ctx)
        user = ctx.split("//", 1)[1].split("@")[0] if "@" in ctx else "root"
        log("")
        log(f"  the UI is bound on {host_name}, not here — tunnel to it with:")
        log(f"    ssh -N -L {ports['ui']}:127.0.0.1:{ports['ui']} {user}@{addr}")


@stack_app.command("ls")
def stack_ls(
    host: str | None = typer.Option(None, "--host", help="Only this host."),
    as_json: bool = JSON_OPT,
) -> None:
    """List telemetry stacks: where they are, whether they run, and whether the
    ingest is actually answering."""
    set_json_mode(as_json)
    reg = load_registry()
    names = [host] if host else list(registry_hosts(reg)) or [None]
    rows = []
    for hname in names:
        try:
            resolved_name, host_rec = resolve_deploy_host(hname)
        except Fatal:
            continue
        driver = host_rec.get("driver") or detect_runtime()
        try:
            present = host_container_names(host_rec, include_stopped=True)
            live = host_container_names(host_rec, include_stopped=False)
        except Fatal, OSError, subprocess.SubprocessError:
            # UNREACHABLE IS NOT ABSENT (Feature 014's rule). We cannot see the
            # host, so we do not claim its stacks are stopped — or that it has
            # none, which would be the same lie in a quieter form.
            rows.append({"name": "?", "host": resolved_name, "state": "undetermined",
                         "ui": "-", "ingest": "-"})  # fmt: skip
            continue
        for cn in sorted(present):
            if not cn.startswith(STACK_CONTAINER_PREFIX):
                continue
            sname = cn.removeprefix(STACK_CONTAINER_PREFIX)
            ports = stack_ports_for_name(sname)
            state = "running" if cn in live else "stopped"
            answering = "-"
            if state == "running":
                answering = (
                    "yes"
                    if stack_ready_probe(
                        stack_operator_probe_endpoint(ports["otlp_http"]), timeout=3
                    )
                    else "NO"
                )
            rows.append({
                "name": sname, "host": resolved_name, "state": state,
                "ui": stack_operator_url("localhost", ports["ui"]),
                "ingest": answering,
                "otlp_endpoint": stack_container_endpoint(ports["otlp_http"], driver),
            })  # fmt: skip
    if as_json:
        emit_json({"stacks": rows})
        return
    if not rows:
        log("no telemetry stacks")
        return
    log(f"{'NAME':<14}{'HOST':<14}{'STATE':<14}{'INGEST':<8}UI")
    for r in rows:
        log(f"{r['name']:<14}{r['host']:<14}{r['state']:<14}{r['ingest']:<8}{r['ui']}")


@stack_app.command("remove")
@stack_app.command("rm", hidden=True)
def stack_remove(
    name: str = typer.Argument(..., help="Stack short name."),
    host: str | None = typer.Option(None, "--host", help="Host it runs on."),
    purge: bool = typer.Option(False, "--purge", help="Also discard collected telemetry."),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip the confirmation."),
    as_json: bool = JSON_OPT,
) -> None:
    """Stop and delete a telemetry stack. Spelled out because it is destructive.

    The collected data is RETAINED unless --purge: a stack is cheap to recreate
    and its trail is not.
    """
    set_json_mode(as_json)
    validate_name(name)
    host_name, host_rec = resolve_deploy_host(host)
    cname = stack_container_name(name)
    if not yes:
        if not is_tty():
            die("refusing destructive 'remove' without -y/--yes on a non-TTY")
        if not questionary.confirm(f"Remove telemetry stack '{name}'?", default=False).ask():
            die("aborted")

    project = f"{STACK_CONTAINER_PREFIX}{name}"
    compose_path = compose_file_path(host_name, f"stack-{name}")
    args = ["down"] + (["-v"] if purge else [])
    if compose_path.is_file():
        run_child(driver_compose_argv(host_rec, project, compose_path, *args))
    else:
        run_child(driver_runtime_argv(host_rec) + ["rm", "-f", cname])
    log(f"removed telemetry stack '{name}' from {host_name}")
    log(
        f"collected telemetry {'DISCARDED' if purge else 'retained on its volume'}"
        + ("" if purge else f" ({stack_volume_name(name)}) — use --purge to discard it")
    )
    # SAID OUT LOUD, because the consequence is otherwise invisible: export
    # fails open, so anything still pointed here stops being recorded WITHOUT
    # an error appearing anywhere.
    log(
        "any environment still exporting to this stack now fails open — its telemetry "
        "stops silently, with no error in the run or the record"
    )
    with contextlib.suppress(Exception):
        set_inventory_outcome(name, host_name, "destroyed")
    emit_action("telemetry-stack-remove", name=name, host=host_name, purged=purge)


@stack_app.command("dashboards")
def stack_dashboards(
    name: str = typer.Argument(..., help="Stack short name."),
    host: str | None = typer.Option(None, "--host", help="Host it runs on."),
    as_json: bool = JSON_OPT,
) -> None:
    """Re-install the tool's dashboards. Does not redeploy, restart, or discard
    anything already collected (FR-015)."""
    set_json_mode(as_json)
    validate_name(name)
    host_name, host_rec = resolve_deploy_host(host)
    cname = stack_container_name(name)
    with contextlib.suppress(Fatal, OSError, subprocess.SubprocessError):
        if cname not in host_container_names(host_rec, include_stopped=False):
            die(f"telemetry stack '{name}' is not running on {host_name}")
    ports = stack_ports_for_name(name)
    installed, failed = stack_provision_dashboards(name, ports["ui"])
    if not installed and not failed:
        log("no dashboards are defined in this build")
    emit_action("telemetry-stack-dashboards", name=name, host=host_name, installed=installed)


@telemetry_app.command("collect")
def telemetry_collect(
    host: list[str] | None = typer.Option(
        None, "--host", help="Collect from these hosts only (repeatable). Default: every host."
    ),
    name: list[str] | None = typer.Option(
        None,
        "--name",
        help="Collect for these environments only (repeatable). Default: every environment.",
    ),
    as_json: bool = JSON_OPT,
) -> None:
    """Download the trail from each host into the operator's durable store.

    Works WHETHER OR NOT an export endpoint is declared: the local record exists
    unconditionally, so its retrieval must too. Reports per-host counts and NAMES
    every host it could not reach — a skipped host must never read as a complete
    trail.
    """
    set_json_mode(as_json)
    do_telemetry_collect(host or None, name or None, as_json)


@telemetry_app.command("reconcile")
def telemetry_reconcile(
    since: str | None = typer.Option(
        None,
        "--since",
        help="Window lower bound (RFC3339). Default: the last successful reconcile. "
        "Pass an explicit range to re-examine settled history — a record the collector "
        "loses AFTER a window agreed is outside every later default window.",
    ),
    until: str | None = typer.Option(None, "--until", help="Window upper bound (RFC3339)."),
    collector_ids: Path | None = typer.Option(
        None,
        "--collector-ids",
        help="File of run ids your collector holds, one per line. Without it, no "
        "comparison is made — and the tool says so rather than implying agreement.",
    ),
    as_json: bool = JSON_OPT,
) -> None:
    """Do the two legs agree? (SC-020)

    Compares locally-`accepted` records against the set your collector holds, over
    a window: since the last successful `reconcile`, or a range you supply.
    `pending` records are OUTSIDE the window — they have not finished exporting,
    and counting them as divergence would fail this against a healthy system.

    The collector's side is a file you produce from your own backend's query. The
    tool does not query it: that would be the vendor coupling FR-009d forbids, and
    it is the same coupling that makes end-to-end ingestion unobservable in the
    first place.

    Exits non-zero on any divergence, in either direction.
    """
    set_json_mode(as_json)
    do_telemetry_reconcile(since, until, collector_ids, as_json)


@telemetry_app.command("retry")
def telemetry_retry(
    host: str | None = typer.Option(None, "--host", help="Only records from this host."),
    name: str | None = typer.Option(None, "--name", help="Only records for this environment."),
    as_json: bool = JSON_OPT,
) -> None:
    """Re-export records that are `pending` or `failed`.

    This is what makes `collect` a RECOVERY path rather than only a downloader
    (FR-009h, research R10). `accepted` and `rejected` are terminal and are never
    retried: re-exporting an accepted record would duplicate it at the collector,
    and re-exporting a rejected one repeats a refusal that will be refused again
    unchanged.
    """
    set_json_mode(as_json)
    do_telemetry_retry(host, name, as_json)


