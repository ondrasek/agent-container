    """Generate a NEW agent SSH key, keeping the workspace."""
    set_json_mode(as_json)
    do_ssh_key_rotate(name, yes, as_json)


inventory_app = typer.Typer(
    no_args_is_help=True,
    help=(
        "Durable record of every environment this tool created — what, where, when, "
        "and what became of it. Survives the container, the host and the registry "
        f"entry, so it can answer 'did we make this?' about something still billing "
        f"you on a host you removed. Kept indefinitely: pruning is COUNT-only at "
        f"{INVENTORY_MAX_ENTRIES} entries and never by age, because the entry most "
        f"worth having is the one you forgot six months ago."
    ),
)
app.add_typer(inventory_app, name="inventory")


@app.command()
def panic(
    host: list[str] = typer.Option(
        None, "--host", help="Limit to these hosts (repeatable). Default: every recorded host."
    ),
    name: list[str] = typer.Option(
        None, "--name", help="Limit to these environments (repeatable)."
    ),
    destroy: bool = typer.Option(
        False,
        "--destroy",
        help="Remove the containers AND their volumes (never images). For a suspected "
        "credential leak: stopping leaves volumes that may hold a login.",
    ),
    preview: bool = typer.Option(
        False, "--preview", help="Show what would be affected, and change nothing."
    ),
    timeout: float = typer.Option(
        KILL_HOST_TIMEOUT, "--host-timeout", help="Per-host budget in seconds."
    ),
    yes: bool = typer.Option(False, "-y", "--yes", help="Skip the --destroy confirmation."),
    as_json: bool = JSON_OPT,
) -> None:
    """STOP EVERYTHING this tool is running, everywhere (the kill switch).

    Enumerates from the durable inventory rather than from whichever hosts answer,
    verifies every stop by observation, and reports overall FAILURE if anything was
    not stopped or could not be confirmed.

    Runaway or looping agent -> plain `panic` (recoverable; volumes intact).
    Suspected credential leak -> `panic --destroy` (a volume may hold a login).
    Revoking a credential at the provider is outside this tool.
    """
    set_json_mode(as_json)
    do_panic(list(host or []), list(name or []), destroy, yes, preview, timeout, as_json)


