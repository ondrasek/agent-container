# The tool's exit codes, documented here, in --help and in docs/ (FR-014a).
# TWO CAVEATS, stated rather than left to be discovered:
#   * 2 is SHARED with the CLI framework's own usage-error code, so it does not
#     uniquely identify a refusal;
#   * a headless `--foreground` run PROPAGATES THE AGENT's exit code, so in that
#     mode the status is not the tool's at all.
EXIT_OK = 0
EXIT_FAILURE = 1
EXIT_REFUSED = 2
EXIT_PENDING_REGISTRATION = 3
EXIT_CODES = (
    (EXIT_OK, "success"),
    (EXIT_FAILURE, "failure"),
    (
        EXIT_REFUSED,
        "refused (usage error, or a destructive action declined without -y on a non-TTY)",
    ),
    (
        EXIT_PENDING_REGISTRATION,
        "pending registration: started, key not registered, nothing cloned",
    ),
)
# Feature 013 reuses the three above rather than defining DOCTOR_EXIT_* aliases with
# the same values. A second namespace for one command is how `doctor`'s 2 and the
# tool-wide 2 drift apart in meaning, and 019 made this tuple the single source that
# `--help` is built from. What `doctor` adds is a READING of each code, not a code:
#   0 = a deploy would succeed (advisories and unknowns permitted)
#   1 = a BLOCKING check FAILED — never merely `unknown`, which cannot carry that
#       assertion (FR-011a)
#   2 = `doctor` itself could not run. Nothing above 2 is available: 3 is taken.
# Feature 013 FR-012a: the building CLI stamps its own version here, and `doctor`
