@host_app.command("rm")
def host_rm(
    name: str = typer.Argument(..., help="Host short name to remove."),
    destroy: bool = typer.Option(
        False,
        "--destroy",
        help="Also deprovision the cloud server (tool-created hosts only; irreversible).",
